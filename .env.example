# =============================================================================
# Text-to-SQL Agent — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Sample Database (quickstart) -------------------------------------------
# Set to "true" to use the bundled SQLite database (no PostgreSQL needed).
USE_SAMPLE_DB=true

# --- PostgreSQL (production) -------------------------------------------------
# Only needed when USE_SAMPLE_DB=false
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mydb
DB_USER=postgres
DB_PASSWORD=changeme

# --- Ollama (free, local LLM) — recommended ----------------------------------
# Install Ollama: https://ollama.com
# Pull a model:   ollama pull llama3.2
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# --- OpenAI (optional, cloud LLM) -------------------------------------------
# Uncomment and set your key to use OpenAI instead of Ollama.
# When OPENAI_API_KEY is set and OLLAMA_MODEL is unset, the agent uses OpenAI.
# OPENAI_API_KEY=sk-...
